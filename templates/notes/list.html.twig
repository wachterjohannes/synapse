{% extends 'base.html.twig' %}

{% block title %}Notes · Synapse{% endblock %}

{% block body %}
<main class="mx-auto max-w-3xl px-6 pt-8 pb-20">
    <div class="text-xs font-bold uppercase tracking-[0.2em] text-rust">Symfony AI · Synapse</div>
    <h1 class="mt-1 mb-4 text-5xl font-bold">Notes</h1>
    <p class="mb-6 text-neutral-700">What the agents wrote is a draft until you have read it. Open a note to mark it as stable, verified or deprecated.</p>

    <div class="mb-8 flex flex-wrap gap-2 text-sm">
        <a href="{{ path('ui_notes') }}" class="rounded-md border border-ink px-3 py-1 {{ filter == '' ? 'bg-ink text-white' : '' }}">All</a>
        {% for status in statuses %}
            <a href="{{ path('ui_notes', {status: status}) }}" class="rounded-md border border-ink px-3 py-1 {{ filter == status ? 'bg-ink text-white' : '' }}">{{ status }} <span class="text-muted">{{ counts[status] }}</span></a>
        {% endfor %}
    </div>

    {% for type, notes in groups %}
        <twig:Panel title="{{ type }}" class="mb-8">
            <ul class="divide-y divide-stone-300">
                {% for note in notes %}
                    <li class="flex items-start justify-between gap-4 py-3">
                        <div>
                            <a href="{{ path('ui_note', {path: note.path}) }}" class="font-bold hover:text-rust">{{ note.title }}</a>
                            <div class="text-sm text-neutral-700">{{ note.description }}</div>
                            <div class="mt-1 font-mono text-xs text-muted">{{ note.path }}</div>
                        </div>
                        <twig:StatusBadge status="{{ note.status }}" class="shrink-0" />
                    </li>
                {% endfor %}
            </ul>
        </twig:Panel>
    {% else %}
        <p class="text-muted">{{ filter ? 'No note has the status ' ~ filter ~ '.' : 'No notes yet.' }}</p>
    {% endfor %}
</main>
{% endblock %}
