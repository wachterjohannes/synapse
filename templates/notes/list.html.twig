{% extends 'base.html.twig' %}

{% block title %}Notes · Synapse{% endblock %}

{% block body %}
<main class="mx-auto max-w-5xl px-5 pt-10 pb-20 sm:px-6">
    <div class="eyebrow">Symfony AI · Synapse</div>
    <h1 class="mt-1 mb-2 font-serif text-4xl font-bold tracking-tight sm:text-5xl">Notes</h1>
    <p class="mb-8 max-w-2xl text-muted">What the agents wrote is a draft until you have read it. Open a note, or mark it as stable, verified or deprecated right here.</p>

    <twig:NotesBrowser />
</main>
{% endblock %}
