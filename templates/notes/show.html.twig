{% extends 'base.html.twig' %}

{% block title %}{{ note.title }} · Synapse{% endblock %}

{% block body %}
<main class="mx-auto max-w-5xl px-5 pt-10 pb-20 sm:px-6"><div class="max-w-3xl">
    <a href="{{ path('ui_notes') }}" class="text-sm text-muted hover:text-rust">&larr; All notes</a>
    <div class="eyebrow mt-4">{{ note.type ?: 'Note' }}</div>
    <h1 class="mt-1 mb-2 font-serif text-3xl font-bold leading-tight tracking-tight sm:text-4xl">{{ note.title }}</h1>
    <p class="mb-6 text-muted">{{ note.description }}</p>

    <twig:Panel title="Status">
        <div class="mb-3 flex items-center gap-3">
            <twig:StatusBadge status="{{ note.status }}" />
            {% if flash %}<span class="text-sm text-muted">Saved. The change is in log.md.</span>{% endif %}
        </div>
        <form action="{{ path('ui_note_status') }}" method="post" class="flex flex-wrap gap-2">
            <input type="hidden" name="path" value="{{ note.path }}">
            {% for status in statuses %}
                <button name="status" value="{{ status }}" {{ status == note.status ? 'disabled' }} class="btn btn-small">{{ status }}</button>
            {% endfor %}
        </form>
        <dl class="mt-5 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
            <dt class="text-muted">Path</dt><dd class="break-all font-mono">{{ note.path }}</dd>
            {% if note.tags %}<dt class="text-muted">Tags</dt><dd>{{ note.tags|join(', ') }}</dd>{% endif %}
            {% if note.generatedBy %}<dt class="text-muted">Written by</dt><dd>{{ note.generatedBy }}{{ note.generatedAt ? ', ' ~ note.generatedAt }}</dd>{% endif %}
            {% for source in note.sources %}
                <dt class="text-muted">Source {{ source.id ?? '' }}</dt>
                <dd class="break-all">{{ source.resource ?? '' }}</dd>
            {% endfor %}
        </dl>
    </twig:Panel>

    <article class="md mt-8 border-t-2 border-ink pt-5">
        {{ html|raw }}
    </article>
</div></main>
{% endblock %}
