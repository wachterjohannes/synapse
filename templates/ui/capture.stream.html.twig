{# "reply" is the HTML of MarkdownRenderer, so it is not escaped again. #}
<turbo-stream action="update" target="capture-out">
    <template>{{ reply|raw }}</template>
</turbo-stream>
{% if filed %}
{# A short note that the capture went through. It also empties the form, which no longer has anything to send. #}
<turbo-stream action="append" target="toasts">
    <template>
        <div data-controller="toast" data-toast-reset-value="capture-form" role="status"
             class="toast-in pointer-events-auto flex items-center gap-2 rounded-md border border-line bg-surface px-4 py-2 text-sm shadow-lg">
            <twig:ux:icon name="lucide:circle-check" class="size-4 text-emerald-600 dark:text-emerald-400" />Filed. The reply is below the form.
        </div>
    </template>
</turbo-stream>
{% endif %}
