{# Last event of an answer: removing the source element closes the EventSource, so the browser does not ask again. #}
<turbo-stream action="update" target="answer-{{ id }}-actions">
    <template><button type="button" data-action="speak#play" class="rounded-md border border-ink px-3 py-1 text-sm">Read it aloud</button><audio controls hidden data-speak-target="audio" class="mt-2 w-full"></audio></template>
</turbo-stream>
<turbo-stream action="remove" target="answer-{{ id }}-source"></turbo-stream>
<turbo-stream action="remove" target="answer-{{ id }}-wait"></turbo-stream>
