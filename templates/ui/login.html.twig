{% extends 'base.html.twig' %}

{% block title %}Sign in · Synapse{% endblock %}

{% block body %}
<main class="mx-auto max-w-sm px-5 pt-16 pb-20 sm:pt-24">
    <div class="eyebrow">Symfony AI · Synapse</div>
    <h1 class="mt-1 mb-6 font-serif text-4xl font-bold tracking-tight">Sign in</h1>

    {% if error %}
        <p class="mb-4 rounded-md border border-rust px-3 py-2 text-sm text-rust" role="alert">{{ error }}</p>
    {% endif %}

    <form action="{{ path('ui_login') }}" method="post" data-turbo="false">
        <label class="mb-1 block text-sm font-bold" for="username">User</label>
        <input id="username" name="_username" value="{{ username ?: 'synapse' }}" required autocomplete="username" class="field mb-4">
        <label class="mb-1 block text-sm font-bold" for="password">Password</label>
        <input id="password" type="password" name="_password" required autofocus autocomplete="current-password" class="field mb-4">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn-primary">Sign in</button>
    </form>
    <p class="mt-6 text-sm text-muted">The password is <code>UI_PASSWORD</code> from <code>.env.local</code>.</p>
</main>
{% endblock %}
