{# Records from the microphone and puts what was said into the textarea of the same form. #}
<button type="button"
        class="rounded-md border border-ink px-4 py-2 data-[recording=true]:border-rust data-[recording=true]:bg-rust data-[recording=true]:text-white"
        data-action="recorder#toggle"
        data-recorder-target="button">Record</button>
