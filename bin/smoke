#!/usr/bin/env bash
# Smoke test of the checked out step. Without COHERE_API_KEY it only checks the wiring,
# with a key the agents answer for real. Run it after "composer install".
# The notes are copied first and put back at the end. If a run is killed hard, var/smoke-notes stays and the next run refuses to start.
set -uo pipefail
cd "$(dirname "$0")/.."

FAILED=0
ok()    { echo "  ok    $1"; }
fail()  { echo "  FAIL  $1"; FAILED=1; }
check() { if eval "$2" >/dev/null 2>&1; then ok "$1"; else fail "$1"; fi; }
# An answer comes from a model over the network. A request stalls now and then, and a model words things
# differently each time. live runs a command up to three times, until its output matches the pattern.
# The output of the last try stays in OUT.
live() {
    local pattern=$1 try; shift
    for try in 1 2 3; do
        OUT=$("$@" </dev/null 2>&1)
        echo "$OUT" | grep -q -- "$pattern" && return 0
    done
    return 1
}

[ -f .env.local ] && set -a && . ./.env.local && set +a
LIVE=0; [ -n "${COHERE_API_KEY:-}" ] && LIVE=1
echo "== $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo step)"
[ $LIVE = 1 ] && echo "  live: COHERE_API_KEY is set, the agents answer for real" || echo "  wiring only: COHERE_API_KEY is empty"

mkdir -p var
# A backup left by an aborted run holds the real notes. Never overwrite it.
if [ -e var/smoke-notes ]; then
    echo "var/smoke-notes exists: a previous run was aborted. Compare it with notes/, move your notes back, delete var/smoke-notes and run again." >&2
    exit 1
fi
cp -a notes var/smoke-notes || { echo "could not back up notes/" >&2; exit 1; }
PIDS=""
# The notes are changed during the run and a change rebuilds the index, so the run works on an index of its own.
SMOKE_DB=$PWD/var/smoke-brain.sqlite
rm -f "$SMOKE_DB"
export BRAIN_DB=$SMOKE_DB
# stream ids and rate limit state live in the cache of a server: a run must not inherit them from the one before
rm -rf var/cache-ui var/cache-down var/share-ui var/share-down
cleanup() {
    # php -S with PHP_CLI_SERVER_WORKERS leaves its workers behind when only the main process is stopped
    for PID in $PIDS; do
        pkill -P "$PID" 2>/dev/null
        kill "$PID" 2>/dev/null
    done
    rm -rf notes && mv var/smoke-notes notes
    rm -f "$SMOKE_DB"
}
trap cleanup EXIT

check "the container compiles" "php bin/console cache:clear"
check "app:capture is registered" "php bin/console list app --raw | grep -q '^app:capture'"
check "the OKF validator accepts a good note and rejects a bad one" "php tools/okf-check.php"

if [ $LIVE = 1 ]; then
    BEFORE=$(find notes -type f | LC_ALL=C sort)
    for TRY in 1 2 3; do
        php bin/console app:capture "Rough idea, unsorted: smoke test note about nothing. Put it in the inbox." </dev/null >/dev/null 2>&1
        NEW=$(LC_ALL=C comm -13 <(echo "$BEFORE") <(find notes -type f | LC_ALL=C sort))
        [ -n "$NEW" ] && break
    done
    check "app:capture files a note" "[ -n \"\$NEW\" ]"
fi

if php bin/console list app --raw | grep -q '^app:ask'; then
    check "app:ask is registered" "true"
    if [ $LIVE = 1 ]; then
        # start from an empty index: indexing twice would store every passage twice
        php bin/console ai:store:drop brain --force </dev/null >/dev/null 2>&1
        php bin/console ai:store:setup brain </dev/null >/dev/null 2>&1
        check "the brain indexes" "php bin/console ai:store:index brain </dev/null"
        live 'symfony-ai-1-0-beta1.md' php bin/console app:ask "What breaks when I upgrade to Symfony AI 1.0 beta?"
        check "app:ask answers from the notes and names the source" "echo \"\$OUT\" | grep -q 'symfony-ai-1-0-beta1.md'"
    fi
fi

# free_port PORT: stops the run when something already answers there. Otherwise the checks would talk to a server
# of an earlier run, with its old notes, its old password and its old code.
free_port() {
    if curl -s -o /dev/null --max-time 1 http://127.0.0.1:$1/; then
        echo "port $1 is already in use. Stop that server (an earlier run may have left one) and run again." >&2
        exit 1
    fi
}
# serve NAME PORT: starts the app on a port. The variables go through the environment, which php -S
# only passes on when variables_order contains E.
serve() {
    free_port $2
    php -d variables_order=EGPCS -S 127.0.0.1:$2 -t public public/index.php >/dev/null 2>&1 &
    PIDS="$PIDS $!"
}
# token CLIENT RESOURCE: asks the fake authorization server for a token that is meant for RESOURCE
token() {
    curl -s -X POST http://127.0.0.1:$AS_PORT/token -d client_id=$1 -d client_secret=$1-secret -d resource=$2 | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p'
}
# mcp URL TOKEN PAYLOAD: one JSON-RPC call inside a fresh MCP session
mcp() {
    local H=(-H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream')
    local init='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"smoke","version":"1"}}}'
    local session
    session=$(curl -si -X POST "$1" -H "Authorization: Bearer $2" "${H[@]}" -d "$init" | tr -d '\r' | sed -n 's/^[Mm]cp-[Ss]ession-[Ii]d: //p')
    curl -s -o /dev/null -X POST "$1" -H "Authorization: Bearer $2" -H "Mcp-Session-Id: $session" "${H[@]}" -d '{"jsonrpc":"2.0","method":"notifications/initialized"}'
    curl -s -X POST "$1" -H "Authorization: Bearer $2" -H "Mcp-Session-Id: $session" "${H[@]}" -d "$3"
}

if php bin/console debug:router --raw 2>/dev/null | grep -q '/mcp'; then
    check "the MCP route exists" "true"
    PORT=${BRAIN_PORT:-38591}; AS_PORT=${AS_PORT:-38592}
    MCP=http://127.0.0.1:$PORT/mcp
    export OAUTH_INTROSPECTION_URL=http://127.0.0.1:$AS_PORT/introspect OAUTH_AUDIENCE=$MCP OAUTH_ISSUER=http://127.0.0.1:$AS_PORT
    free_port $AS_PORT
    php -S 127.0.0.1:$AS_PORT tools/fake-as.php >/dev/null 2>&1 &
    PIDS="$PIDS $!"
    APP_CACHE_DIR=$PWD/var/cache-smoke serve brain $PORT
    # a second brain whose authorization server does not exist: nothing listens on DEAD_PORT
    DOWN_PORT=${DOWN_PORT:-38593}; DEAD_PORT=${DEAD_PORT:-38599}
    free_port $DEAD_PORT
    # The rate limit keeps its count in the share dir, so every server that is tried against it gets its own.
    # it also serves the UI, with a dummy Cohere key and no ElevenLabs key: the page can be looked at and the rate limit tried without a paid call
    UI_PASSWORD=smoke-ui COHERE_API_KEY=smoke-dummy ELEVENLABS_API_KEY= OAUTH_INTROSPECTION_URL=http://127.0.0.1:$DEAD_PORT/introspect APP_CACHE_DIR=$PWD/var/cache-down APP_SHARE_DIR=$PWD/var/share-down serve down $DOWN_PORT
    sleep 2
    CHALLENGE=$(curl -si -X POST $MCP -H 'Content-Type: application/json' -d '{}' | tr -d '\r')
    check "MCP without a token is 401" "echo \"\$CHALLENGE\" | head -1 | grep -q ' 401'"
    check "the 401 points to the protected resource metadata" "echo \"\$CHALLENGE\" | grep -qi '^www-authenticate: Bearer resource_metadata=.*oauth-protected-resource'"
    OTHERHOST=$(curl -si -X POST http://localhost:$PORT/mcp -H 'Content-Type: application/json' -d '{}' | tr -d '\r')
    check "the 401 names the configured address, whatever host the request came through" "echo \"\$OTHERHOST\" | grep -qi '^www-authenticate: Bearer resource_metadata=\"http://127.0.0.1:$PORT/.well-known/oauth-protected-resource\"'"
    SLASHES=$(curl -s http://127.0.0.1:$PORT/.well-known/oauth-protected-resource)
    check "the metadata keeps its slashes" "echo \"\$SLASHES\" | grep -q '\"resource\":\"http://127.0.0.1:$PORT/mcp\"'"
    check "the metadata names the authorization server" "curl -s http://127.0.0.1:$PORT/.well-known/oauth-protected-resource | grep -q authorization_servers"
    check "the 401 names the scope that opens the endpoint" "echo \"\$CHALLENGE\" | grep -qi 'scope=\"brain:read\"'"
    check "the metadata is also served below the path of the resource (RFC 9728)" "curl -s http://127.0.0.1:$PORT/.well-known/oauth-protected-resource/mcp | grep -q authorization_servers"
    check "the path variant knows no other path" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' http://127.0.0.1:$PORT/.well-known/oauth-protected-resource/other)\" = 404 ]"
    READER=$(token reader $MCP); ADMIN=$(token admin $MCP); GUEST=$(token guest $MCP)
    GUEST_ANSWER=$(curl -si -X POST $MCP -H "Authorization: Bearer $GUEST" -H 'Content-Type: application/json' -d '{}' | tr -d '\r')
    check "a valid token without a brain scope is 403 with insufficient_scope" "echo \"\$GUEST_ANSWER\" | head -1 | grep -q ' 403' && echo \"\$GUEST_ANSWER\" | grep -qi '^www-authenticate: .*error=\"insufficient_scope\"'"
    check "an authorization server that cannot be reached is 503, not 401" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -X POST http://127.0.0.1:$DOWN_PORT/mcp -H \"Authorization: Bearer $READER\" -H 'Content-Type: application/json' -d '{}')\" = 503 ]"
    INIT='{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"smoke","version":"1"}}}'
    check "MCP initialize works with a valid token" "mcp $MCP $READER '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}' | grep -q search_notes"
    OTHER=$(token reader http://127.0.0.1:1/other-brain/mcp)
    check "a token that was issued for another brain is rejected" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -X POST $MCP -H \"Authorization: Bearer $OTHER\" -H 'Content-Type: application/json' -d '$INIT')\" = 401 ]"
    # keyed on the role setup, not on the guard: a removed guard must turn the checks red, not skip them
    if grep -q role_hierarchy config/packages/security.yaml; then
        WRITE='{"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"save_to_inbox","arguments":{"slug":"smoke-'$$'","text":"hello"}}}'
        check "a reader may not write" "mcp $MCP $READER '$WRITE' | grep -q 'may only read'"
        check "an admin may write" "mcp $MCP $ADMIN '$WRITE' | grep -q 'Saved inbox'"
        BADREAD='{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"read_note","arguments":{"path":"../.env"}}}'
        check "a tool that cannot do what it was asked is an MCP tool error with the reason" "mcp $MCP $READER '$BADREAD' | grep -q '\"isError\":true' && mcp $MCP $READER '$BADREAD' | grep -q 'not a valid note path'"
        printf 'Error: this is the text of a note.\n' > notes/brain/topics/error-start.md
        ERRNOTE='{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"read_note","arguments":{"path":"brain/topics/error-start.md"}}}'
        check "a note that starts with Error: is read as a note, not as a tool error" "mcp $MCP $READER '$ERRNOTE' | grep -q 'text of a note' && ! mcp $MCP $READER '$ERRNOTE' | grep -q '\"isError\":true'"
        BRAIN='{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"save_to_brain","arguments":{"path":"topics/smoke.md","type":"Topic","title":"Smoke","description":"x","tags":["x"],"body":"# Smoke"}}}'
        check "a reader may not write to the brain either" "mcp $MCP $READER '$BRAIN' | grep -q 'may only read'"
        # every tool the server lists, not just the two above: a tool added later is checked too
        GUARDS=$(php tools/guard-check.php $MCP $READER notes 2>&1); GUARD_RC=$?
        echo "$GUARDS"
        check "every tool is either read-only or refused for a reader" "[ $GUARD_RC = 0 ]"
    fi

    if php bin/console list app --raw | grep -q '^app:federate'; then
        check "app:federate is registered" "true"
        if [ $LIVE = 1 ]; then
            # a second brain with its own notes, its own index and its own audience
            FRIEND_PORT=${FRIEND_PORT:-38512}
            FRIEND=http://127.0.0.1:$FRIEND_PORT/mcp
            export BRAIN_DIR=$PWD/examples/friend-notes BRAIN_DB=$PWD/var/friend.sqlite
            rm -f "$BRAIN_DB"
            php bin/console ai:store:setup brain </dev/null >/dev/null 2>&1
            php bin/console ai:store:index brain </dev/null >/dev/null 2>&1
            OAUTH_AUDIENCE=$FRIEND APP_CACHE_DIR=$PWD/var/cache-friend serve friend $FRIEND_PORT
            unset BRAIN_DIR; export BRAIN_DB=$SMOKE_DB
            sleep 2
            OUT=$(FRIEND_BRAIN_URL=$FRIEND FRIEND_BRAIN_TOKEN=$(token reader $FRIEND) php bin/console app:federate "How do I protect an MCP server?" </dev/null 2>&1)
            check "app:federate ranks passages of both brains" "echo \"\$OUT\" | grep -q 'friend:' && echo \"\$OUT\" | grep -q 'mine:'"
            OUT=$(FRIEND_BRAIN_URL=$FRIEND FRIEND_BRAIN_TOKEN=$(token reader $MCP) php bin/console app:federate "How do I protect an MCP server?" </dev/null 2>&1)
            check "a token for another brain is refused, the own passages still come back" "echo \"\$OUT\" | grep -q 'Could not ask' && echo \"\$OUT\" | grep -q 'mine:'"
        fi
    fi
fi
if [ -f config/providers/huggingface.yaml ]; then
    check "SYNAPSE_PROVIDER=huggingface compiles" "SYNAPSE_PROVIDER=huggingface APP_CACHE_DIR=\$PWD/var/cache-hf php bin/console cache:clear"
    check "an unknown SYNAPSE_PROVIDER is refused" "! SYNAPSE_PROVIDER=nope APP_CACHE_DIR=\$PWD/var/cache-nope php bin/console cache:clear"
fi

if [ -f src/Controller/UiController.php ]; then
    check "the stylesheet builds" "php bin/console tailwind:build"
    UI_PORT=${UI_PORT:-38601}; UI=http://127.0.0.1:$UI_PORT
    # php -S needs workers here, because an answer streams while the page loads its assets
    UI_PASSWORD=smoke-ui PHP_CLI_SERVER_WORKERS=4 APP_CACHE_DIR=$PWD/var/cache-ui APP_SHARE_DIR=$PWD/var/share-ui serve ui $UI_PORT
    sleep 2
    check "the UI sends a visitor to the login page" "[ \"\$(curl -s -o /dev/null -w '%{http_code} %{redirect_url}' $UI/)\" = '302 $UI/login' ]"
    JAR=var/smoke-cookies.txt; rm -f $JAR
    csrf() { curl -s -c $JAR -b $JAR $UI/login | grep -o 'name="_csrf_token" value="[^"]*"' | sed 's/.*value="//; s/"//'; }
    check "a wrong password is sent back to the login page" "[ \"\$(curl -s -c $JAR -b $JAR -o /dev/null -w '%{http_code} %{redirect_url}' $UI/login -d _username=synapse -d _password=wrong --data-urlencode _csrf_token=\$(csrf))\" = '302 $UI/login' ]"
    check "a login without the form token is refused" "[ \"\$(curl -s -o /dev/null -w '%{redirect_url}' $UI/login -d _username=synapse -d _password=smoke-ui)\" = '$UI/login' ]"
    check "the right password opens the page with a session" "[ \"\$(curl -s -c $JAR -b $JAR -o /dev/null -w '%{http_code}' $UI/login -d _username=synapse -d _password=smoke-ui --data-urlencode _csrf_token=\$(csrf))\" = 302 ] && curl -s -b $JAR $UI/ | grep -q 'Your second brain'"
    check "a session still needs the sign of this page to write" "[ \"\$(curl -s -b $JAR -o /dev/null -w '%{http_code}' -X POST $UI/ui/capture -d text=x)\" = 403 ] && curl -s -b $JAR -X POST $UI/ui/capture -H 'Sec-Fetch-Site: same-origin' -d text= | grep -q 'Write something first'"
    check "signing out ends the session" "curl -s -b $JAR -c $JAR -o /dev/null \"$UI\$(curl -s -b $JAR $UI/ | grep -o 'href=\"/logout[^\"]*\"' | sed 's/href=\"//; s/\"//; s/&amp;/\\&/g')\" && [ \"\$(curl -s -b $JAR -o /dev/null -w '%{http_code}' $UI/)\" = 302 ]"
    rm -f $JAR
    check "a request for another host name is refused" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -H 'Host: evil.example:$UI_PORT' $UI/)\" = 400 ]"
    check "the UI opens with the password" "[ \"\$(curl -s -u synapse:smoke-ui $UI/ | grep -c 'Your second brain')\" = 1 ]"
    check "the UI serves its stylesheet" "curl -s -u synapse:smoke-ui $UI/ | grep -o '/assets/styles/app-[^\"]*.css' | head -1 | xargs -I{} curl -sf -o /dev/null $UI{}"
    check "a request from another site is refused" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -X POST $UI/ui/capture -H 'Sec-Fetch-Site: cross-site' -d text=x)\" = 403 ]"
    check "a request without a sign of this page is refused" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -X POST $UI/ui/capture -d text=x)\" = 403 ]"
    HEADERS=$(curl -si -u synapse:smoke-ui $UI/ | tr -d '\r')
    check "the page has a CSP with a nonce, and may not be framed" "echo \"\$HEADERS\" | grep -qi \"^content-security-policy: .*script-src 'self' 'nonce-\" && echo \"\$HEADERS\" | grep -qi \"frame-ancestors 'none'\" && echo \"\$HEADERS\" | grep -qi '^x-frame-options: DENY'"
    check "every script of the page carries the nonce" "[ \"\$(curl -s -u synapse:smoke-ui $UI/ | grep -o '<script[^>]*>' | grep -vc nonce)\" = 0 ]"
    check "an empty capture is answered without a model" "curl -s -u synapse:smoke-ui -X POST $UI/ui/capture -H 'X-Synapse-Ui: 1' -d text= | grep -q 'Write something first'"
    check "a capture that is too long is refused" "curl -s -u synapse:smoke-ui -X POST $UI/ui/capture -H 'X-Synapse-Ui: 1' --data-urlencode \"text=\$(head -c 9000 /dev/zero | tr '\\0' a)\" | grep -q 'too long'"
    ASK=$(curl -s -u synapse:smoke-ui -X POST http://127.0.0.1:$DOWN_PORT/ui/ask -H 'X-Synapse-Ui: 1' -d question=hello)
    CARD=$(echo "$ASK" | grep -o 'id="answer-[0-9a-f]\{8\}"' | head -1 | sed 's/id="answer-\(.*\)"/\1/')
    check "an answer card shows a waiting hint with the id the stream removes, and opens its stream" "[ -n \"\$CARD\" ] && echo \"\$ASK\" | grep -q \"id=\\\"answer-\$CARD-wait\\\"\" && echo \"\$ASK\" | grep -q \"ask/\$CARD/stream\""
    check "an empty question is turned down without a stream" "curl -s -u synapse:smoke-ui -X POST $UI/ui/ask -H 'X-Synapse-Ui: 1' -d question= | grep -q 'Ask something first' && ! curl -s -u synapse:smoke-ui -X POST $UI/ui/ask -H 'X-Synapse-Ui: 1' -d question= | grep -q turbo-stream-source"
    check "a stream without a question is refused" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -H 'X-Synapse-Ui: 1' \"$UI/ui/ask/abcd0000/stream?q=\")\" = 400 ]"
    check "speak refuses a text that is not a string" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -X POST $UI/ui/speak -H 'X-Synapse-Ui: 1' -H 'Content-Type: application/json' -d '{\"text\":[\"a\"]}')\" = 400 ]"
    check "speak refuses a text that is too long" "[ \"\$(head -c 5000 /dev/zero | tr '\\0' a | sed 's/^/{\"text\":\"/; s/\$/\"}/' | curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -X POST $UI/ui/speak -H 'X-Synapse-Ui: 1' -H 'Content-Type: application/json' --data-binary @-)\" = 413 ]"
    printf 'not audio' > var/smoke-not-audio.txt
    check "transcribe refuses a file that is not audio" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -H 'X-Synapse-Ui: 1' -F audio=@var/smoke-not-audio.txt $UI/ui/transcribe)\" = 415 ]"
    check "transcribe wants a file" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -X POST -H 'X-Synapse-Ui: 1' $UI/ui/transcribe)\" = 400 ]"
    rm -f var/smoke-not-audio.txt
    # the "down" server has no ElevenLabs key, so every call is refused after the limit took its token, and none costs anything
    LIMIT_CODES=$(for i in $(seq 1 26); do curl -s -o /dev/null -w '%{http_code}\n' -u synapse:smoke-ui -X POST http://127.0.0.1:$DOWN_PORT/ui/speak -H 'X-Synapse-Ui: 1' -H 'Content-Type: application/json' -d '{"text":"hello"}'; done)
    check "the rate limit turns away the calls over the limit" "echo \"\$LIMIT_CODES\" | grep -q '^429\$'"
    if grep -q "'ui_notes'" src/Controller/NotesController.php; then
        printf -- '---\ntype: Topic\ntitle: "Smoke status"\ndescription: "A draft for the status checks."\ntags: [smoke]\nstatus: draft\ngenerated:\n  by: synapse/1.0\n  at: 2026-11-01T08:00:00Z\n---\n\n# Smoke status\n\nSee [RAG](/topics/rag-basics.md).\n' > notes/brain/topics/smoke-status.md
        NOTE=brain/topics/smoke-status.md
        check "the notes page needs the password" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' $UI/ui/notes)\" = 302 ] && [ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui $UI/ui/notes)\" = 200 ]"
        check "the notes page lists a note with its status" "curl -s -u synapse:smoke-ui '$UI/ui/notes?status=draft' | grep -q 'Smoke status'"
        check "the status filter hides the other notes" "! curl -s -u synapse:smoke-ui '$UI/ui/notes?status=draft' | grep -q 'RAG basics'"
        check "a note shows its text and links to the other note" "curl -s -u synapse:smoke-ui '$UI/ui/note?path=$NOTE' | grep -q 'ui/note?path=brain/topics/rag-basics.md'"
        check "log.md is not shown as a note" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui '$UI/ui/note?path=brain/log.md')\" = 404 ]"
        check "a status change from another site is refused" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -X POST $UI/ui/note/status -H 'Sec-Fetch-Site: cross-site' -d path=$NOTE -d status=verified)\" = 403 ]"
        check "an unknown status is refused" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -X POST $UI/ui/note/status -H 'X-Synapse-Ui: 1' -d path=$NOTE -d status=approved)\" = 422 ]"
        check "the file is still a draft after both" "grep -q '^status: draft' notes/$NOTE"
        check "the browser changes the status and sends you back to the note" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -X POST $UI/ui/note/status -H 'X-Synapse-Ui: 1' -d path=$NOTE -d status=verified)\" = 303 ] && grep -q '^status: verified' notes/$NOTE"
        check "app:status sets a status" "php bin/console app:status $NOTE stable </dev/null && grep -q '^status: stable' notes/$NOTE"
        check "app:status --list finds it" "php bin/console app:status --list=stable </dev/null | grep -q smoke-status.md"
        check "app:status refuses an unknown status" "! php bin/console app:status $NOTE approved </dev/null"
        check "both changes are in log.md" "grep -q 'status of $NOTE: draft to verified' notes/brain/log.md && grep -q 'status of $NOTE: verified to stable' notes/brain/log.md"
    fi
    if [ $LIVE = 1 ]; then
        # every stream answers once, so every try gets a new id
        for TRY in 1 2 3; do
            SID=$(printf '%07x' $((RANDOM*RANDOM)) | cut -c1-7)$TRY
            curl -sN -m 240 -u synapse:smoke-ui -H 'X-Synapse-Ui: 1' "$UI/ui/ask/$SID/stream?q=What+breaks+when+I+upgrade+to+Symfony+AI+1.0+beta%3F" > var/smoke-stream.txt
            grep -q "action=\"remove\" target=\"answer-$SID-source\"" var/smoke-stream.txt && grep -q 'symfony-ai-1-0-beta1.md' var/smoke-stream.txt && break
        done
        check "the UI streams the answer word by word" "[ \"\$(grep -c 'action=\"append\"' var/smoke-stream.txt)\" -gt 5 ]"
        # the words arrive in pieces, so the text is put back together before it is searched
        check "the stream names the source" "grep 'action=\"append\"' var/smoke-stream.txt | sed 's/<[^>]*>//g; s/^data: //' | tr -d '\\n' | grep -q 'symfony-ai-1-0-beta1.md'"
        check "the stream ends by closing its own source" "grep -q \"action=\\\"remove\\\" target=\\\"answer-$SID-source\\\"\" var/smoke-stream.txt"
        check "the stream takes the waiting hint away" "grep -q \"action=\\\"remove\\\" target=\\\"answer-$SID-wait\\\"\" var/smoke-stream.txt"
        check "a second request for the same stream is not answered again (204)" "[ \"\$(curl -s -o /dev/null -w '%{http_code}' -u synapse:smoke-ui -H 'X-Synapse-Ui: 1' \"$UI/ui/ask/$SID/stream?q=again\")\" = 204 ]"
        rm -f var/smoke-stream.txt
        if [ -n "${ELEVENLABS_API_KEY:-}" ]; then
            check "the UI reads an answer aloud" "[ \"\$(curl -s -o var/smoke-answer.mp3 -w '%{content_type}' -u synapse:smoke-ui -X POST $UI/ui/speak -H 'X-Synapse-Ui: 1' -H 'Content-Type: application/json' -d '{\"text\":\"Hello from the brain.\"}')\" = audio/mpeg ]"
            check "the UI turns speech into text" "curl -s -u synapse:smoke-ui -H 'X-Synapse-Ui: 1' -F audio=@var/smoke-answer.mp3 $UI/ui/transcribe | grep -qi 'hello'"
            rm -f var/smoke-answer.mp3
        fi
    fi
fi
exit $FAILED
