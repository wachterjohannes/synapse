# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
# Host names the app answers to, as a regular expression. This keeps a web page on another site from reaching
# the local server under its own name (DNS rebinding). Widen it if you serve the app under another name.
TRUSTED_HOSTS='^(127\.0\.0\.1|localhost|\[::1\])(:\d+)?$'
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/ai-bundle ###
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
ELEVENLABS_API_KEY=
# voice for the spoken answers, any voice id of your ElevenLabs account
ELEVENLABS_VOICE=JBFqnCBsd6RMkjVDRZzb
# the browser UI at / is off while the password is empty, see src/Controller/UiController.php
UI_PASSWORD=
# cohere or huggingface: embeddings and agent models, see config/providers/
SYNAPSE_PROVIDER=cohere
###< symfony/ai-bundle ###

###> brain/oauth ###
# The authorization server that issues and checks tokens. tools/fake-as.php stands in for it locally.
OAUTH_INTROSPECTION_URL=http://127.0.0.1:8081/introspect
# Who a token has to be meant for. Ask the authorization server for the token with resource=<this URL>.
OAUTH_AUDIENCE=http://127.0.0.1:8080/mcp
OAUTH_ISSUER=http://127.0.0.1:8081
OAUTH_RESOURCE_CLIENT_ID=brain-server
OAUTH_RESOURCE_CLIENT_SECRET=brain-server-secret
###< brain/oauth ###

###> brain/friend ###
# A second brain to ask, and a token for it. Ask the authorization server of that brain for a token with resource=<its MCP URL>, for example:
#   curl -d client_id=reader -d client_secret=reader-secret -d resource=$FRIEND_BRAIN_URL http://127.0.0.1:8081/token
FRIEND_BRAIN_URL=http://127.0.0.1:38512/mcp
FRIEND_BRAIN_TOKEN=
###< brain/friend ###
