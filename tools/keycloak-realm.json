{
  "realm": "synapse",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "defaultDefaultClientScopes": [
    "basic",
    "brain-audience",
    "brain:read"
  ],
  "defaultOptionalClientScopes": [],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "brain:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "brain:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "brain-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "brain url",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "included.custom.audience": "http://127.0.0.1:8080/mcp"
          }
        },
        {
          "name": "brain-server",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "id.token.claim": "false",
            "included.client.audience": "brain-server"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "brain-server",
      "secret": "brain-server-secret",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [],
      "optionalClientScopes": []
    },
    {
      "clientId": "reader",
      "secret": "reader-secret",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "brain-audience",
        "brain:read"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "admin",
      "secret": "admin-secret",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "brain-audience",
        "brain:read",
        "brain:write"
      ],
      "optionalClientScopes": []
    }
  ],
  "components": {
    "org.keycloak.services.clientregistration.policy.ClientRegistrationPolicy": [
      {
        "name": "Trusted Hosts",
        "providerId": "trusted-hosts",
        "subType": "anonymous",
        "config": {
          "host-sending-registration-request-must-match": [
            "false"
          ],
          "client-uris-must-match": [
            "true"
          ],
          "trusted-hosts": [
            "localhost",
            "127.0.0.1"
          ]
        }
      },
      {
        "name": "Allowed Client Scopes",
        "providerId": "allowed-client-templates",
        "subType": "anonymous",
        "config": {
          "allow-default-scopes": [
            "true"
          ]
        }
      },
      {
        "name": "Allowed Client Scopes",
        "providerId": "allowed-client-templates",
        "subType": "authenticated",
        "config": {
          "allow-default-scopes": [
            "true"
          ]
        }
      },
      {
        "name": "Consent Required",
        "providerId": "consent-required",
        "subType": "anonymous",
        "config": {}
      },
      {
        "name": "Max Clients Limit",
        "providerId": "max-clients",
        "subType": "anonymous",
        "config": {
          "max-clients": [
            "200"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "joe",
      "enabled": true,
      "email": "joe@example.com",
      "firstName": "Joe",
      "lastName": "Doe",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "joe",
          "temporary": false
        }
      ]
    }
  ]
}